    private void StartButton_Click(object sender, EventArgs e)
    {
        var profession = _professionPicker.SelectedIndex switch
        {
            1 => Profession.Carpenter,
            2 => Profession.Banker,
            _ => Profession.Farmer
        };

        _gameState.PlayerName = string.IsNullOrWhiteSpace(_nameInput.Text) ? "Traveler" : _nameInput.Text.Trim();
        var started = TrailGameEngine.CreateNewGame(_gameState.PlayerName, profession);
        _gameState.PlayerName = started.PlayerName;
        _gameState.Profession = started.Profession;
        _gameState.Money = started.Money;
        _gameState.Food = started.Food;
        _gameState.Oxen = started.Oxen;
        _gameState.Bullets = started.Bullets;
        _gameState.Clothing = started.Clothing;
        _gameState.WagonHealth = started.WagonHealth;
        _gameState.PartyMembers = started.PartyMembers;
        _gameState.Members.Clear();
        foreach (var member in started.Members)
            _gameState.Members.Add(member);
        _gameState.Journal.Clear();
        foreach (var entry in started.Journal)
            _gameState.Journal.Add(entry);
        _gameState.HasWon = false;
        _gameState.RewardClaimed = false;
        _gameState.Score = 0;
        _gameState.Location = "Independence, Missouri";
        _gameState.Distance = 0;
        _gameState.Day = 1;
        _gameState.Month = 3;
        _gameState.Year = 1848;
        _gameState.CurrentWeather = "Clear";
        _gameState.MilesPerDay = 20;

        UpdateSummary();
        RefreshJournal();
    }

    private void NextDayButton_Click(object sender, EventArgs e)
    {
        _engine.AdvanceDay();
        UpdateSummary();
        RefreshJournal();
    }

    private void HuntButton_Click(object sender, EventArgs e)
    {
        _engine.Hunt();
        UpdateSummary();
        RefreshJournal();
    }

    private void RestButton_Click(object sender, EventArgs e)
    {
        _engine.Rest();
        UpdateSummary();
        RefreshJournal();
    }

    private void RiverButton_Click(object sender, EventArgs e)
    {
        _engine.CrossRiver();
        UpdateSummary();
        RefreshJournal();
    }

    private void ClaimRewardButton_Click(object sender, EventArgs e)
    {
        if (!_gameState.HasWon)
        {
            MessageBox.Show("Complete your journey before claiming the Arcade1870 reward.", "Journey incomplete", MessageBoxButtons.OK, MessageBoxIcon.Information);
            return;
        }

        if (_gameState.RewardClaimed)
        {
            MessageBox.Show("This reward has already been claimed for this journey.", "Already claimed", MessageBoxButtons.OK, MessageBoxIcon.Information);
            return;
        }

        _gameState.RewardClaimed = true;
        _settings.RewardAmount = "5";

        var rewardText =
            $"Arcade1870 reward claim prepared.\n" +
            $"Vault: {_settings.RewardVaultAddress}\n" +
            $"Contract: {_settings.Arcade1870ContractAddress}\n" +
            $"Amount: {_settings.RewardAmount} A1870\n" +
            $"Issuer URL: {_settings.RewardIssuerUrl}";

        MessageBox.Show(rewardText, "Reward ready", MessageBoxButtons.OK, MessageBoxIcon.Information);
        UpdateSummary();
        RefreshJournal();
    }

    private void UpdateSummary()
    {
        _summaryLabel.Text = _engine.BuildSummaryText();
        _mapPanel.Invalidate();
    }

    private void RefreshJournal()
    {
        _journalBox.Text = string.Join(Environment.NewLine, _gameState.Journal.TakeLast(12));
    }

    private void MapPanel_Paint(object sender, PaintEventArgs e)
    {
        var g = e.Graphics;
        g.Clear(Color.FromArgb(120, 160, 110));

        var trail = new PointF[]
        {
            new(20, 270),
            new(100, 210),
            new(180, 250),
            new(280, 170),
            new(420, 230),
            new(540, 200),
            new(650, 250)
        };

        using var trailPen = new Pen(Color.FromArgb(130, 90, 45), 18);
        g.DrawLines(trailPen, trail);

        using var riverPen = new Pen(Color.FromArgb(80, 130, 200), 22);
        g.DrawLine(riverPen, new Point(300, 0), new Point(300, 380));

        using var landmarkBrush = new SolidBrush(Color.FromArgb(90, 60, 30));
        g.FillRectangle(landmarkBrush, new Rectangle(110, 175, 26, 60));
        g.FillRectangle(landmarkBrush, new Rectangle(500, 160, 32, 80));

        var wagonX = 20 + (_gameState.Distance / (float)_gameState.MaxDistance) * (650 - 20);
        var wagonY = 260 + ((int)_gameState.CurrentWeather.Length % 3) * 8;
        var wagonRect = new RectangleF(wagonX - 20, wagonY - 12, 40, 24);

        using var wagonBrush = new SolidBrush(Color.FromArgb(115, 65, 25));
        g.FillRectangle(wagonBrush, wagonRect);

        using var oxBrush = new SolidBrush(Color.FromArgb(90, 90, 90));
        g.FillEllipse(oxBrush, wagonX - 28, wagonY + 10, 14, 14);
        g.FillEllipse(oxBrush, wagonX + 10, wagonY + 10, 14, 14);

        using var textBrush = new SolidBrush(Color.White);
        g.DrawString("Trail to Oregon", new Font("Segoe UI", 18, FontStyle.Bold), textBrush, new PointF(260, 14));
        g.DrawString("Independence", new Font("Segoe UI", 10, FontStyle.Bold), textBrush, new PointF(18, 300));
        g.DrawString("Oregon", new Font("Segoe UI", 10, FontStyle.Bold), textBrush, new PointF(610, 300));
    }
}
