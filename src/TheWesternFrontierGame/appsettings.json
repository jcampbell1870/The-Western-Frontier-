using System.Text.Json;
using System.Windows.Forms;

namespace TheWesternFrontierGame;

public sealed class GameRewardSettings
{
    public string Arcade1870ContractAddress { get; set; } = "0x8eddD4edea39c5B5f77662453600F53A202EE47C";
    public string RewardVaultAddress { get; set; } = "0x1e4f6e4a382adbdb662733a19ae773d3ab8f497d";
    public string RewardIssuerUrl { get; set; } = "https://www.cryptohockey.org/api/reward-claim";
    public string RewardAmount { get; set; } = "5";
    public string RewardSignerPrivateKey { get; set; } = "";
    public string RewardSignerAddress { get; set; } = "";
    public string EthereumRpcUrl { get; set; } = "https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY";
}

public enum Profession
{
    Banker,
    Carpenter,
    Farmer
}

public sealed class PartyMember
{
    public string Name { get; set; } = string.Empty;
    public int Health { get; set; } = 100;
    public bool Alive { get; set; } = true;
}

public sealed class GameState
{
    public string PlayerName { get; set; } = "Traveler";
    public Profession Profession { get; set; } = Profession.Farmer;
    public int Money { get; set; } = 0;
    public int Food { get; set; } = 0;
    public int Oxen { get; set; } = 0;
    public int Bullets { get; set; } = 0;
    public int Clothing { get; set; } = 0;
    public int WagonHealth { get; set; } = 100;
    public int PartyMembers { get; set; } = 5;
    public int Distance { get; set; } = 0;
    public int MaxDistance { get; set; } = 2000;
    public int Month { get; set; } = 3;
    public int Day { get; set; } = 1;
    public int Year { get; set; } = 1848;
    public string Location { get; set; } = "Independence, Missouri";
    public bool HasWon { get; set; }
    public bool RewardClaimed { get; set; }
    public int Score { get; set; }
    public readonly List<string> Journal = new();
    public readonly List<PartyMember> Members = new();
    public string CurrentWeather { get; set; } = "Clear";
    public int RiverRisk { get; set; } = 0;
    public int MilesPerDay { get; set; } = 20;
}

public sealed class TrailGameEngine
{
    private readonly Random _random = new();
    private readonly GameState _state;

    public TrailGameEngine(GameState state)
    {
        _state = state;
    }

    public static GameState CreateNewGame(string playerName, Profession profession)
    {
        var state = new GameState { PlayerName = playerName, Profession = profession };
        switch (profession)
        {
            case Profession.Banker:
                state.Money = 1600;
                state.Food = 200;
                state.Oxen = 2;
                state.Bullets = 120;
                state.Clothing = 8;
                break;
            case Profession.Carpenter:
                state.Money = 800;
                state.Food = 180;
                state.Oxen = 2;
                state.Bullets = 90;
                state.Clothing = 8;
                break;
            default:
                state.Money = 400;
                state.Food = 220;
                state.Oxen = 2;
                state.Bullets = 80;
                state.Clothing = 10;
                break;
        }

        state.PartyMembers = 5;
        state.Members.Clear();
        for (var i = 0; i < state.PartyMembers; i++)
        {
            state.Members.Add(new PartyMember { Name = $"Traveler {i + 1}", Health = 100, Alive = true });
        }

        state.Journal.Add("The wagon rolls west from Independence, Missouri.");
        state.Journal.Add("Your party is ready for the long frontier journey.");

        return state;
    }

    public void AdvanceDay()
    {
        if (_state.HasWon)
        {
            return;
        }

        var weatherRoll = _random.Next(0, 100);
        if (weatherRoll < 25)
            _state.CurrentWeather = "Clear";
        else if (weatherRoll < 50)
            _state.CurrentWeather = "Rain";
        else if (weatherRoll < 70)
            _state.CurrentWeather = "Wind";
        else if (weatherRoll < 85)
            _state.CurrentWeather = "Snow";
        else
            _state.CurrentWeather = "Extreme Heat";

        var movement = 18 + _random.Next(0, 18);
        _state.Distance += movement;
        _state.Day++;
        if (_state.Day > 30)
        {
            _state.Day = 1;
            _state.Month++;
        }
        if (_state.Month > 12)
        {
            _state.Month = 1;
            _state.Year++;
        }

        var foodUse = _state.PartyMembers * 2;
        _state.Food -= foodUse;

        var eventRoll = _random.Next(0, 100);
        if (eventRoll < 18)
        {
            _state.Journal.Add($"A sudden storm damages the wagon and slows your progress.");
            _state.WagonHealth -= 10;
            _state.Distance -= 10;
        }
        else if (eventRoll < 34)
        {
            _state.Journal.Add("You find a safe river crossing and restock morale.");
            _state.Score += 10;
        }
        else if (eventRoll < 48)
        {
            _state.Journal.Add("A member falls ill from harsh conditions.");
            foreach (var member in _state.Members)
            {
                if (member.Alive)
                {
                    member.Health -= 10;
                    if (member.Health <= 0)
                    {
                        member.Alive = false;
                        _state.PartyMembers--;
                    }
                }
            }
        }
        else if (eventRoll < 65)
        {
            _state.Journal.Add("You spot grazing animals and make better time on the trail.");
            _state.Distance += 8;
        }

        if (_state.WagonHealth <= 0)
        {
            _state.Journal.Add("Your wagon is broken beyond repair. The journey ends here.");
            _state.HasWon = false;
            _state.RewardClaimed = true;
        }

        if (_state.Food <= 0)
        {
            _state.Journal.Add("The party is running low on food. Survival becomes desperate.");
            foreach (var member in _state.Members)
            {
                if (member.Alive)
                {
                    member.Health -= 15;
                    if (member.Health <= 0)
                    {
                        member.Alive = false;
                        _state.PartyMembers--;
                    }
                }
            }
        }

        if (_state.Distance >= _state.MaxDistance)
        {
            _state.HasWon = true;
            _state.Score += 200;
            _state.Location = "Oregon City, Oregon";
            _state.Journal.Add("You reach the promised land on the frontier. Your journey is complete.");
        }

        if (_state.PartyMembers <= 0)
        {
            _state.HasWon = false;
            _state.Journal.Add("The wagon party is lost. The journey fails.");
        }
    }

    public void Hunt()
    {
        if (_state.Bullets <= 0)
        {
            _state.Journal.Add("You have no ammunition left to hunt.");
            return;
        }

        _state.Bullets -= 10;
        var success = _random.Next(0, 100) > 25;
        if (success)
        {
            var meat = 30 + _random.Next(0, 50);
            _state.Food += meat;
            _state.Score += 15;
            _state.Journal.Add($"A successful hunt yields {meat} pounds of food.");
        }
        else
        {
            _state.Journal.Add("The hunt fails, but the party remains determined.");
        }
    }

    public void Rest()
    {
        _state.Journal.Add("The party rests and recovers from the trail.");
        foreach (var member in _state.Members)
        {
            if (member.Alive && member.Health < 100)
            {
                member.Health = Math.Min(100, member.Health + 15);
            }
        }

        _state.Score += 5;
    }

    public void CrossRiver()
    {
        if (_state.Distance > _state.MaxDistance)
            return;

        var danger = _random.Next(0, 100);
        if (danger < 35)
        {
            _state.Journal.Add("The river crossing is smooth and the wagon makes it through safely.");
            _state.Score += 10;
        }
        else if (danger < 70)
        {
            _state.Journal.Add("The river is dangerous. A few supplies are lost in the crossing.");
            _state.Food -= 20;
            _state.Money -= 20;
            _state.Score += 5;
        }
        else
        {
            _state.Journal.Add("The crossing turns tragic. The wagon suffers damage and a traveler is injured.");
            _state.WagonHealth -= 15;
            foreach (var member in _state.Members)
            {
                if (member.Alive)
                {
                    member.Health -= 15;
                    if (member.Health <= 0)
                    {
                        member.Alive = false;
                        _state.PartyMembers--;
                    }
                }
            }
        }
    }

    public string BuildSummaryText()
    {
        return $"Name: {_state.PlayerName}\n" +
               $"Profession: {_state.Profession}\n" +
               $"Date: {_state.Month}/{_state.Day}/{_state.Year}\n" +
               $"Location: {_state.Location}\n" +
               $"Distance: {_state.Distance}/{_state.MaxDistance} miles\n" +
               $"Weather: {_state.CurrentWeather}\n" +
               $"Food: {_state.Food}\n" +
               $"Money: ${_state.Money}\n" +
               $"Oxen: {_state.Oxen}\n" +
               $"Bullets: {_state.Bullets}\n" +
               $"Clothing: {_state.Clothing}\n" +
               $"Wagon Health: {_state.WagonHealth}%\n" +
               $"Alive: {_state.PartyMembers} / 5\n" +
               $"Score: {_state.Score}\n" +
               $"Reward ready: {(_state.HasWon && !_state.RewardClaimed ? "Yes" : "No")}";
    }
}

public partial class MainForm : Form
{
    private readonly GameState _gameState;
    private readonly TrailGameEngine _engine;
    private readonly GameRewardSettings _settings;

    private readonly Label _summaryLabel = new();
    private readonly TextBox _journalBox = new();
    private readonly Panel _mapPanel = new();
    private readonly Button _startButton = new();
    private readonly Button _nextDayButton = new();
    private readonly Button _huntButton = new();
    private readonly Button _restButton = new();
    private readonly Button _riverButton = new();
    private readonly ComboBox _professionPicker = new();
    private readonly TextBox _nameInput = new();

    public MainForm()
    {
        _settings = LoadSettings();
        _gameState = TrailGameEngine.CreateNewGame("Traveler", Profession.Farmer);
        _engine = new TrailGameEngine(_gameState);

        InitializeForm();
        UpdateSummary();
        _journalBox.Text = string.Join(Environment.NewLine, _gameState.Journal);
    }

    private static GameRewardSettings LoadSettings()
    {
        try
        {
            var path = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "appsettings.json");
            if (File.Exists(path))
            {
                var json = File.ReadAllText(path);
                var settings = JsonSerializer.Deserialize<GameRewardSettings>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });
                if (settings is not null)
                    return settings;
            }
        }
        catch
        {
            // Ignore config load issues and use defaults.
        }

        return new GameRewardSettings();
    }

